{
  "manifest_version": 3,
  "name": "CanvasCode - 网页可视化微调与Prompt生成器",
  "version": "1.0.0",
  "description": "像做PPT一样在网页中可视化拉伸、拖拽排版与改色，一键生成供 Cursor、Claude、Gemini 使用的高精度代码修改 Prompt 与截图",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "file://*/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "开启/关闭 AI 可视化微调"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
